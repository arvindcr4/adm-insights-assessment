server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 100k;
  server_tokens off;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" always;

  # Resolve at request time so nginx starts even if the API container is still booting.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $upstream http://backend:8000;

  location /api/ {
    proxy_pass $upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # The BFF requires this key when INSIGHTS_API_KEYS is set; the browser never sees it.
    proxy_set_header X-API-Key "${API_KEY}";
    proxy_read_timeout 120s;
  }
  location ~ ^/(docs|redoc|openapi\.json)$ {
    proxy_pass $upstream;
    proxy_set_header Host $host;
    proxy_set_header X-API-Key "${API_KEY}";
  }
  location / {
    try_files $uri /index.html;
  }
}
