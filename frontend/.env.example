# Base URL of the BFF. Leave unset in dev to use the Vite proxy (/api -> http://localhost:8000).
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# Client-side request timeout and retry backoff base (transient failures only; the POST is never retried).
# VITE_API_TIMEOUT_MS=15000
# VITE_API_RETRY_BASE_MS=300
